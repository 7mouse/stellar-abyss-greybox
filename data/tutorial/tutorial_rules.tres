boss_name = "苔冠王野猪"
move_text = "[%s] 先站起来。"
attack_text = "[%s] 拔刀。连砍三下，第三下最重。"
dash_text = "[%s] 冲过去。动起来的那一瞬间，刀砍不到你。"
