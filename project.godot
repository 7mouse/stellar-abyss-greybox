; Engine configuration file.
config_version=5

[application]

config/name="Stellar Abyss 灰盒 2"
run/main_scene="res://scenes/village/village.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Settings="*res://autoload/settings.gd"
Log="*res://autoload/log.gd"
Lineage="*res://autoload/lineage.gd"
Game="*res://autoload/game.gd"
NoiseBus="*res://autoload/noise_bus.gd"
SysLog="*res://scenes/ui/sys_log_flash.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-Greybox.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.06, 1)
